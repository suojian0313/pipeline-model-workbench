    "@types/node": "^22.18.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "4.1.12",
    "vue-tsc": "^3.1.4"
  }
}
