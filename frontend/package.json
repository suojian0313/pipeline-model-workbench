{
  "name": "pipeline-model-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/copy-cesium.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 0.0.0.0",
