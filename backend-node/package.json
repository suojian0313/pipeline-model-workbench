{
  "name": "shiti-node-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:built": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "import": "tsx src/cli.ts import",
    "seed-demo": "tsx src/cli.ts seed-demo"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/static": "10.1.2",
    "dotenv": "17.2.3",
    "fastify": "5.12.5",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
